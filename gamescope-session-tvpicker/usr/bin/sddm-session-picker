#!/usr/bin/env bash
# Decides which session SDDM should auto-login to, and writes the SDDM
# autologin fragment accordingly. Run from ExecStartPre= on sddm.service.
#   --dry-run   report the decision, write nothing
set -uo pipefail

CONF=/etc/gamescope-session-tvpicker.conf
MODE_FILE=/etc/sddm-session-mode
OUT=/etc/sddm.conf.d/zzz-session-picker.conf

AUTOLOGIN_USER=
TV_MATCH=
GAMESCOPE_SESSION=gamescope-session
DESKTOP_SESSION=plasma
DESKTOP_AUTOLOGIN=no

# shellcheck source=/dev/null
[[ -r $CONF ]] && . "$CONF"

# Unset means the one regular user of a single-seat machine.
[[ -n $AUTOLOGIN_USER ]] || AUTOLOGIN_USER=$(getent passwd 1000 | cut -d: -f1)

dry_run=no
[[ ${1:-} == --dry-run ]] && dry_run=yes

# Printable text of one connector's EDID. Fails if the blob is empty, which is
# how a port that reports "connected" with nothing behind it gets filtered out.
edid_text() {
    local raw
    raw=$(cat "$1/edid" 2>/dev/null | tr -dc '[:print:]')
    [[ -n $raw ]] && printf '%s' "$raw"
}

# One line per screen that is really there.
screens() {
    local c txt
    for c in /sys/class/drm/card*-*; do
        [[ -e $c/status ]] || continue
        [[ $(< "$c/status") == connected ]] || continue
        txt=$(edid_text "$c") || continue
        [[ -n $txt ]] && printf '%s\t%s\n' "${c##*/}" "$txt"
    done
}

# The DRM driver may not have probed every connector yet this early in boot.
list=""
for _ in {1..15}; do
    list=$(screens)
    [[ -n $list ]] && break
    sleep 0.2
done

mode=auto
[[ -r $MODE_FILE ]] && mode=$(tr -d '[:space:]' < "$MODE_FILE")

case $mode in
    gamescope|desktop)
        target=$mode
        ;;
    *)
        mode=auto
        # Attaching the TV is the signal. A screen that is never unplugged
        # cannot distinguish one intent from the other, so it is not consulted.
        if [[ -n $TV_MATCH ]] && grep -qiF "$TV_MATCH" <<<"$list"; then
            target=gamescope
        else
            target=desktop
        fi
        ;;
esac

if [[ $target == gamescope && -z $AUTOLOGIN_USER ]]; then
    echo "sddm-session-picker: no AUTOLOGIN_USER set in $CONF, falling back to the greeter" >&2
    target=desktop
fi

printf 'sddm-session-picker: mode=%s target=%s screens=[%s]\n' \
    "$mode" "$target" "$(cut -f1 <<<"$list" | paste -sd, -)"

[[ $dry_run == yes ]] && exit 0

# Every fragment in /etc/sddm.conf.d is merged in alphabetical order and the
# last one wins, so this file is named to sort past anything else in there,
# gamescope-session-cachyos's zz-steamos-autologin.conf included. Blanking
# User= is what actually disables autologin: leaving the key out would let an
# earlier fragment's value survive.
tmp=$(mktemp "${OUT%/*}/.picker.XXXXXX") || exit 0
{
    echo '# Generated by sddm-session-picker. Do not edit.'
    echo '[Autologin]'
    case $target in
        gamescope)
            echo "User=$AUTOLOGIN_USER"
            echo "Session=$GAMESCOPE_SESSION"
            ;;
        desktop)
            if [[ $DESKTOP_AUTOLOGIN == yes ]]; then
                echo "User=$AUTOLOGIN_USER"
                echo "Session=$DESKTOP_SESSION"
            else
                echo 'User='
                echo 'Session='
            fi
            ;;
    esac
    echo 'Relogin=false'
} > "$tmp"
chmod 0644 "$tmp"
mv -f "$tmp" "$OUT"
