#!/usr/bin/env bash
# Picks the Plasma Login autologin session from the attached display, and
# switches between the desktop and Steam Big Picture on demand.
#
#   gamescope-tvsession                       show mode, decision and screens
#   gamescope-tvsession apply                 write the config fragment (root)
#   gamescope-tvsession auto|desktop|gamescope [--now]
#   gamescope-tvsession now desktop|gamescope  one session only, mode untouched
#   gamescope-tvsession menu                  graphical mode picker
#   gamescope-tvsession switch                go to Big Picture now
set -uo pipefail

CONF=/etc/gamescope-tvsession.conf
MODE_FILE=/var/lib/gamescope-tvsession/mode
# Lives on tmpfs, so a one-shot request can never outlast a reboot.
ONCE_FILE=/run/gamescope-tvsession/once
FRAGMENT=/etc/plasmalogin.conf.d/zzz-gamescope-tvsession.conf
TITLE="Game Mode"

AUTOLOGIN_USER=
TV_MATCH=
GAMESCOPE_SESSION=gamescope-session.desktop
DESKTOP_SESSION=plasma.desktop
DESKTOP_AUTOLOGIN=no

# shellcheck source=/dev/null
[[ -r $CONF ]] && . "$CONF"
[[ -n $AUTOLOGIN_USER ]] || AUTOLOGIN_USER=$(getent passwd 1000 | cut -d: -f1)

self=${0##*/}
# The sudoers rule names an absolute path, so re-invocations must use one too
# rather than whatever $0 happens to be.
SELF=/usr/bin/gamescope-tvsession
die() { echo "$self: $1" >&2; exit 1; }

mode() {
    local m=
    [[ -r $MODE_FILE ]] && m=$(tr -d '[:space:]' < "$MODE_FILE")
    echo "${m:-auto}"
}

# Screens that are really attached. A port reporting "connected" with an empty
# EDID is a phantom, as card1-DP-2 is on this hardware, and does not count.
attached() {
    local c txt
    for c in /sys/class/drm/card*-*; do
        [[ -e $c/status && $(< "$c/status") == connected ]] || continue
        txt=$(cat "$c/edid" 2>/dev/null | tr -dc '[:print:]')
        [[ -n $txt ]] && printf '%s\t%s\n' "${c##*/}" "$txt"
    done
}

# Attaching the TV is the signal. The desk monitor is never unplugged, so it
# carries no information and is not consulted.
decide() {
    case $1 in
        gamescope|desktop) echo "$1" ;;
        *) if [[ -n $TV_MATCH ]] && grep -qiF "$TV_MATCH" <<<"$2"; then
               echo gamescope
           else
               echo desktop
           fi ;;
    esac
}

write_fragment() {
    local tmp
    mkdir -p "${FRAGMENT%/*}"
    tmp=$(mktemp "${FRAGMENT%/*}/.tvsession.XXXXXX") || die "cannot write $FRAGMENT"
    {
        echo "# Generated by $self. Do not edit."
        echo '[Autologin]'
        if [[ $1 == gamescope ]]; then
            echo "User=$AUTOLOGIN_USER"
            echo "Session=$GAMESCOPE_SESSION"
        elif [[ $DESKTOP_AUTOLOGIN == yes ]]; then
            echo "User=$AUTOLOGIN_USER"
            echo "Session=$DESKTOP_SESSION"
        else
            # A blank user is what switches autologin off. Leaving the keys out
            # would let an earlier fragment's value stand.
            echo 'User='
            echo 'Session='
        fi
        echo 'Relogin=false'
        echo
        # Outranks the session the greeter remembers, so leaving Big Picture
        # always returns to a greeter with the desktop already selected.
        echo '[Greeter]'
        echo "PreselectedSession=$DESKTOP_SESSION"
    } > "$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$FRAGMENT"
}

set_mode() {
    (( EUID == 0 )) || die "must run as root to change the mode"
    mkdir -p "${MODE_FILE%/*}"
    printf '%s\n' "$1" > "$MODE_FILE"
    chmod 0644 "$MODE_FILE"
    echo "$self: mode set to $1"
}

case ${1:-status} in
    status)
        list=$(attached)
        current=$(mode)
        printf 'mode:    %s\n' "$current"
        printf 'session: %s\n' "$(decide "$current" "$list")"
        printf 'screens: %s\n' "$(cut -f1 <<<"$list" | paste -sd, -)"
        [[ -r $ONCE_FILE ]] && printf 'once:    %s\n' "$(tr -d '[:space:]' < "$ONCE_FILE")"
        ;;

    apply)
        (( EUID == 0 )) || die "must run as root"
        list=$(attached)
        current=$(mode)
        once=
        [[ -r $ONCE_FILE ]] && once=$(tr -d '[:space:]' < "$ONCE_FILE")
        # Consumed here, so the next login manager start decides from the mode again.
        rm -f "$ONCE_FILE"
        case $once in
            gamescope|desktop) target=$once; current="$current, once" ;;
            *) target=$(decide "$current" "$list") ;;
        esac
        write_fragment "$target"
        echo "$self: mode=$current session=$target screens=[$(cut -f1 <<<"$list" | paste -sd, -)]"
        ;;

    auto|desktop|gamescope)
        set_mode "$1"
        if [[ ${2:-} == --now ]]; then
            "$0" apply
            systemctl restart plasmalogin
        fi
        ;;

    now)
        (( EUID == 0 )) || die "must run as root"
        case ${2:-} in
            gamescope|desktop) ;;
            *) die "usage: $self now desktop|gamescope" ;;
        esac
        mkdir -p "${ONCE_FILE%/*}"
        printf '%s\n' "$2" > "$ONCE_FILE"
        systemctl restart plasmalogin
        ;;

    menu)
        command -v kdialog >/dev/null || die "kdialog is not installed"
        cur=$(mode)
        on() { [[ $cur == "$1" ]] && echo on || echo off; }
        choice=$(kdialog --title "$TITLE" \
            --radiolist "Which session should this machine log into?" \
            auto      "Decide from the attached display" "$(on auto)" \
            desktop   "Always the Plasma desktop"        "$(on desktop)" \
            gamescope "Always Steam Big Picture"         "$(on gamescope)") || exit 0
        out=$(sudo -n "$SELF" "$choice" 2>&1) \
            || { kdialog --title "$TITLE" --error "$out"; exit 1; }
        kdialog --title "$TITLE" --passivepopup "Next login: $choice" 5
        ;;

    switch)
        command -v kdialog >/dev/null || die "kdialog is not installed"
        kdialog --title "$TITLE" --warningcontinuecancel \
            "Switch to Steam Big Picture now?

This restarts the login manager and ends your desktop session immediately. Save your work first." || exit 0
        out=$(sudo -n "$SELF" now gamescope 2>&1) \
            || kdialog --title "$TITLE" --error "$out"
        ;;

    *)
        die "unknown command '$1'; try: status, apply, auto, desktop, gamescope, now, menu, switch"
        ;;
esac
