# Maintainer: shawly <shawlyde@gmail.com>

pkgname=witcher3modmanager-bin
_pkgname=witcher3modmanager
pkgver=0.10.5
pkgrel=4
pkgdesc="Mod manager for The Witcher 3, run inside the game's Steam Proton prefix"
arch=('x86_64')
url="https://github.com/Systemcluster/The-Witcher-3-Mod-manager"
license=('BSD-2-Clause')
depends=('protontricks')
optdepends=('libnotify: desktop notifications during first-run prefix setup')
makedepends=('clang' 'imagemagick' 'lld' 'python-fonttools' 'ttf-liberation')
options=('!strip')
noextract=("$_pkgname-$pkgver.zip")
source=("$_pkgname-$pkgver.zip::$url/releases/download/release-$pkgver/TW3MM.zip"
        "$_pkgname.sh"
        "$_pkgname.desktop"
        "icuuc.def"
        "make-segoeui.py")
sha256sums=('3bc835585eb394a9f5b3c4f18c55416ace2b92076fe22e50dd09de5f6d0c25c6'
            'f9ce9cbc2ca3a510364dd10fd1c482aa0698f2a3de89d2c6677253ed6f7798b0'
            'dc5a69539dedb4af363c4161168ac894437ca9468b4a85891e089ea7f1b98c32'
            'd0fbc7279d16c5584dfa5c2d478385557ffc40b826260007c24bc8082bc6d3ed'
            '664351920595eea0357c21c9f15fa9a852d3e08c9f1a176c9f7fc68db8856701')

prepare() {
    rm -rf app
    mkdir app
    bsdtar -xf "$_pkgname-$pkgver.zip" -C app --no-same-owner
}

build() {
    # w3a.ico is the icon upstream embeds in TheWitcher3ModManager.exe
    magick 'app/res/w3a.ico[0]' "$_pkgname.png"

    # Forwarder from icuuc.dll to Wine's icu.dll; lld-link needs one object to link
    echo 'int _stub;' > stub.c
    clang --target=x86_64-pc-windows-msvc -c stub.c -o stub.obj
    lld-link /dll /noentry /nodefaultlib /machine:x64 /def:icuuc.def /out:icuuc.dll stub.obj

    # Segoe UI stand-in that the run script installs into the prefix for Script Merger
    mkdir -p fonts
    python make-segoeui.py fonts
}

package() {
    install -d "$pkgdir/opt/$_pkgname"
    cp -r app/. "$pkgdir/opt/$_pkgname/"
    install -m644 icuuc.dll "$pkgdir/opt/$_pkgname/icuuc.dll"
    install -Dm644 -t "$pkgdir/opt/$_pkgname/fonts" fonts/segoeui*.ttf
    chmod -R u=rwX,go=rX "$pkgdir/opt/$_pkgname"

    install -Dm755 "$_pkgname.sh" "$pkgdir/usr/bin/$_pkgname"
    install -Dm644 "$_pkgname.desktop" "$pkgdir/usr/share/applications/$_pkgname.desktop"
    install -Dm644 "$_pkgname.png" "$pkgdir/usr/share/icons/hicolor/64x64/apps/$_pkgname.png"
    install -Dm644 app/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 /usr/share/licenses/ttf-liberation/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.fonts"
}
